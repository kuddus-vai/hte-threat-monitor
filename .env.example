# ── Zero-cost stack config ─────────────────────────────
# Copy to .env and fill what you have. Everything works without any key:
# RSS sources + CISA are keyless; OTX needs a free API key (otx.alienvault.com).

# Backend port for the local dev server
PORT=8787

# Ollama (local LLM) — free, local inference
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dolphin-llama3:8b

# AI toggle: "ollama" (default) | "none" (skip AI, use heuristic extraction)
AI_ENGINE=ollama

# AlienVault OTX — free community API key (optional; if empty, OTX is skipped)
OTX_API_KEY=

# Upstash Redis REST — free tier (optional; if empty, in-memory cache is used)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How often the refresh cron should run (minutes)
REFRESH_INTERVAL_MIN=15

# CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173
